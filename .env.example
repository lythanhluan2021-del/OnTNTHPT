# ========================================================
# CẤU HÌNH GIỌNG ĐỌC AI NÂNG CAO CHO HỆ THỐNG ONTNTHPT
# ========================================================

# 1. Khóa FPT.AI Text to Speech (Giọng Miền Tây & MC Bắc chuẩn)
# Đăng ký nhận 100.000 ký tự MIỄN PHÍ mỗi tháng tại: https://console.fpt.ai
# Khi điền khóa này vào đây (.env.local), TOÀN BỘ học sinh trên web sẽ được nghe giọng Miền Tây & MC miễn phí mà không cần tự nhập key!
FPT_AI_API_KEY=

# 2. Khóa OpenAI Audio TTS (Nova & Echo - Chuẩn phòng thu)
# Lấy khóa tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=
